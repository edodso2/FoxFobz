{
  "name": "foxfobz-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "foxfobz.com — single-product store for the Fox Fobz keyless entry kit",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply foxfobz --local",
    "db:migrate:remote": "wrangler d1 migrations apply foxfobz --remote",
    "stripe:listen": "stripe listen --forward-to localhost:4321/api/stripe-webhook --events checkout.session.completed"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "astro": "^7.4.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}
