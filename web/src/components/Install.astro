---
import { product } from '../site.config';
const videoId = product.installVideoId;
---

<section id="install" class="band">
  <div class="container inner">
    <div class="top">
      <div class="intro">
        <div class="eyebrow">Install</div>
        <h2 class="h-section">An afternoon in the garage.</h2>
        <p class="lede">
          Watch the full install start to finish before you buy, so you know exactly what you’re getting into.
        </p>
      </div>
      <dl class="stats">
        <div><dt>Time</dt><dd>{product.installTime}</dd></div>
        <div><dt>Skill</dt><dd>{product.installSkill}</dd></div>
      </dl>
    </div>

    <div class="body">
      <div class="video" id="ff-video" data-video-id={videoId}>
        {
          videoId && (
            <img
              class="poster"
              src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              decoding="async"
              width="480"
              height="360"
            />
          )
        }
        <button type="button" class="play" aria-label="Play install video" disabled={!videoId}>
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M7 4v16l13-8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
            ></path></svg
          >
        </button>
        <div class="caption">{videoId ? 'Full install walkthrough' : 'Install video coming soon'}</div>
      </div>
      <ol class="chapters">
        {
          product.installChapters.map((label, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span>{label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Load the YouTube player only after the visitor asks for it.
  const box = document.getElementById('ff-video')!;
  const id = box.dataset.videoId;
  box.querySelector('button')?.addEventListener('click', () => {
    if (!id) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&modestbranding=1`;
    iframe.title = 'Fox Fobz install video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    box.replaceChildren(iframe);
    iframe.focus();
  });
</script>

<style>
  .inner {
    padding-top: 112px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
  }
  .stats {
    display: flex;
    gap: 40px;
    margin: 0;
  }
  .stats div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  dt {
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
    font-size: 22px;
    font-weight: 300;
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }
  .video {
    position: relative;
    flex: 999 1 640px;
    min-width: 0;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    background: var(--bg);
    border: 1px solid var(--line-mid);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    overflow: hidden;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }
  .play {
    position: relative;
    width: 84px;
    height: 84px;
    border-radius: 999px;
    border: 1px solid var(--text);
    background: rgba(13, 14, 16, 0.4);
    color: var(--text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .play:hover:not(:disabled) {
    background: var(--text);
    color: var(--bg);
  }
  .play:disabled {
    cursor: default;
    opacity: 0.6;
  }
  .caption {
    position: relative;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .chapters {
    flex: 1 1 300px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .chapters li {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
    font-weight: 300;
  }
  .n {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.1em;
    min-width: 28px;
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .inner {
      padding-top: 72px;
      padding-bottom: 72px;
    }
    .video {
      flex-basis: 100%;
      border-radius: 14px;
    }
  }
</style>
