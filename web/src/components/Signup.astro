---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
---

<section id="updates" class="signup">
  <div class="container inner">
    <div class="intro">
      <h2>Join the Fox Fobz list.</h2>
      <p>Build updates, restock alerts and first access to new drops.</p>
    </div>
    <form class="form" id="ff-signup" method="post" action="/api/subscribe" novalidate data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}>
      <label for="ff-email" class="label">Email</label>
      <div class="row">
        <input
          id="ff-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          aria-describedby="ff-signup-msg"
        />
        <button type="submit" class="btn btn-primary">Sign up</button>
      </div>
      <div id="ff-turnstile" class="turnstile"></div>
      <p id="ff-signup-msg" class="msg" role="status" aria-live="polite"></p>
      <p class="fine">
        We’ll only email you about Fox Fobz. See our <a href="/privacy">privacy policy</a>.
      </p>
      <noscript><p class="fine">JavaScript is required to sign up (it runs our spam check).</p></noscript>
    </form>
  </div>
</section>

<script>
  interface Turnstile {
    render(el: HTMLElement, opts: Record<string, unknown>): string;
    execute(id: string): void;
    reset(id: string): void;
  }
  const w = window as unknown as { turnstile?: Turnstile; ffTurnstileReady?: () => void };

  const form = document.getElementById('ff-signup') as HTMLFormElement;
  const input = document.getElementById('ff-email') as HTMLInputElement;
  const msg = document.getElementById('ff-signup-msg')!;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const holder = document.getElementById('ff-turnstile')!;

  // Load Turnstile only when the form is near the viewport, to keep the page fast.
  let loader: Promise<Turnstile> | undefined;
  const loadTurnstile = () =>
    (loader ??= new Promise<Turnstile>((resolve, reject) => {
      w.ffTurnstileReady = () => resolve(w.turnstile!);
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=ffTurnstileReady';
      s.async = true;
      s.onerror = () => {
        loader = undefined;
        reject(new Error('Turnstile failed to load'));
      };
      document.head.appendChild(s);
    }));
  new IntersectionObserver(
    (entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        obs.disconnect();
        loadTurnstile().catch(() => {});
      }
    },
    { rootMargin: '400px' },
  ).observe(form);
  input.addEventListener('focus', () => loadTurnstile().catch(() => {}), { once: true });

  let widgetId: string | undefined;
  let pending: { resolve: (t: string) => void; reject: (e: Error) => void } | undefined;

  async function getToken(): Promise<string> {
    const ts = await loadTurnstile();
    widgetId ??= ts.render(holder, {
      sitekey: form.dataset.sitekey,
      action: 'subscribe',
      theme: 'dark',
      appearance: 'interaction-only',
      execution: 'execute',
      callback: (token: string) => pending?.resolve(token),
      'error-callback': () => pending?.reject(new Error('Verification failed')),
      'timeout-callback': () => pending?.reject(new Error('Verification timed out')),
    });
    return new Promise((resolve, reject) => {
      pending = { resolve, reject };
      ts.execute(widgetId!);
    });
  }

  const show = (text: string, kind: 'ok' | 'error' | '') => {
    msg.textContent = text;
    msg.dataset.kind = kind;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = input.value.trim();
    if (!input.checkValidity() || !email) {
      input.setAttribute('aria-invalid', 'true');
      show('Enter a valid email address, like you@example.com.', 'error');
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');
    button.disabled = true;
    show('Signing you up…', '');

    try {
      const token = await getToken();
      const body = new FormData();
      body.set('email', email);
      body.set('cf-turnstile-response', token);
      const res = await fetch(form.action, { method: 'POST', body });
      const data = (await res.json()) as { ok: boolean; error?: string; field?: string };
      if (data.ok) {
        form.reset();
        show('You’re on the list.', 'ok');
      } else {
        if (data.field === 'email') input.setAttribute('aria-invalid', 'true');
        show(data.error ?? 'Something went wrong. Please try again.', 'error');
      }
    } catch {
      show('We couldn’t sign you up just now. Please try again.', 'error');
    } finally {
      button.disabled = false;
      if (widgetId && w.turnstile) w.turnstile.reset(widgetId);
    }
  });
</script>

<style>
  .signup {
    background: var(--surface-band);
    border-top: 1px solid var(--line);
  }
  .inner {
    padding-top: 88px;
    padding-bottom: 88px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .intro {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h2 {
    margin: 0;
    font-weight: 200;
    font-size: clamp(30px, 3vw, 40px);
  }
  .intro p {
    margin: 0;
    font-size: 17px;
    color: var(--muted);
    line-height: 1.6;
  }
  .form {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  input {
    flex: 1 1 240px;
    min-width: 0;
    font-size: 16px;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 14px 20px;
    min-height: 52px;
  }
  input::placeholder {
    color: var(--subtle);
  }
  input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .row .btn {
    padding: 0 28px;
  }
  .turnstile:empty {
    display: none;
  }
  .msg {
    margin: 4px 0 0;
    min-height: 1.5em;
    font-size: 15px;
    color: var(--text-soft);
  }
  .msg[data-kind='ok'] {
    color: var(--accent);
    font-size: 17px;
  }
  .msg[data-kind='error'] {
    color: var(--danger);
  }
  .fine {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .inner {
      padding-top: 64px;
      padding-bottom: 64px;
    }
  }
</style>
