---
import Photo from './Photo.astro';
import { product } from '../site.config';
---

<section id="top" class="container hero">
  <div class="copy">
    <div class="eyebrow">For the 1985–1993 Mustang</div>
    <h1>Keyless entry, re‑engineered for the Fox.</h1>
    <p class="lede">
      A custom receiver board, two New Edge–style fobs, and an app that watches your door locks for you. Designed
      in‑house, built with modern components.
    </p>
    <div class="ctas">
      <a href="#kit" class="btn btn-primary">Shop the kit — {product.priceDisplay}</a>
      <a href="#install" class="btn btn-ghost">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"
          ><path d="M3 1.5v11l9-5.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
          ></path></svg
        >
        Watch the install
      </a>
    </div>
  </div>
  <div class="art">
    <div class="frame">
      <Photo
        name="hero"
        alt="Fox Fobz key fobs"
        widths={[400, 600, 920]}
        sizes="(max-width: 520px) 100vw, 460px"
        priority
      >
        <svg viewBox="0 0 360 360" class="fobs" aria-hidden="true">
          <g transform="rotate(-14 150 180)">
            <rect x="92" y="54" width="116" height="232" rx="58" fill="#1C1F23" stroke="#3A3E44" stroke-width="1.2"
            ></rect>
            <rect x="104" y="66" width="92" height="208" rx="46" fill="none" stroke="#2A2D31" stroke-width="1"></rect>
            <circle cx="150" cy="118" r="20" fill="#24282D" stroke="#4A4F56"></circle>
            <circle cx="150" cy="170" r="20" fill="#24282D" stroke="#4A4F56"></circle>
            <circle cx="150" cy="222" r="15" fill="#24282D" stroke="#4A4F56"></circle>
            <rect x="143" y="116" width="14" height="10" rx="2" fill="none" stroke="#ECE9E4" stroke-width="1.3"></rect>
            <path d="M146 116v-4a4 4 0 0 1 8 0v4" fill="none" stroke="#ECE9E4" stroke-width="1.3"></path>
            <rect x="143" y="168" width="14" height="10" rx="2" fill="none" stroke="#ECE9E4" stroke-width="1.3"></rect>
            <path d="M146 168v-4a4 4 0 0 1 8 -1" fill="none" stroke="#ECE9E4" stroke-width="1.3"></path>
            <circle cx="150" cy="222" r="4" fill="#E9A23B"></circle>
            <circle cx="150" cy="44" r="10" fill="none" stroke="#3A3E44" stroke-width="3"></circle>
          </g>
          <g transform="rotate(10 232 196)" opacity="0.55">
            <rect x="182" y="82" width="104" height="210" rx="52" fill="#16191C" stroke="#33373C" stroke-width="1.2"
            ></rect>
            <circle cx="234" cy="138" r="17" fill="#1E2125" stroke="#3A3E44"></circle>
            <circle cx="234" cy="184" r="17" fill="#1E2125" stroke="#3A3E44"></circle>
            <circle cx="234" cy="228" r="13" fill="#1E2125" stroke="#3A3E44"></circle>
          </g>
        </svg>
      </Photo>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 96px;
    padding-bottom: 80px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 64px;
  }
  .copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  h1 {
    margin: 0;
    font-weight: 200;
    font-size: clamp(44px, 6vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .lede {
    font-size: 20px;
    color: var(--text-lede);
    max-width: 540px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 8px;
  }
  .art {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .frame {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    border-radius: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .fobs {
    width: 82%;
    height: auto;
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 56px;
      padding-bottom: 56px;
      gap: 48px;
    }
    .lede {
      font-size: 18px;
    }
    .copy,
    .art {
      flex-basis: 100%;
    }
  }
</style>
